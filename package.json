{
  "name": "nekocord",
  "version": "1.6.0",
  "private": true,
  "description": "Your cutest Discord client on mobile — fast TypeScript plugin runtime and theme engine for Discord Android.",
  "author": "flufstail <flufstails@gmail.com>",
  "homepage": "https://github.com/flufstails/nekocord",
  "repository": {
    "type": "git",
    "url": "https://github.com/flufstails/nekocord.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "gen:plugins": "node runtime/scripts/generate-plugins.mjs",
    "build:runtime": "node runtime/build.mjs",
    "build:android": "node patcher/build-android.mjs",
    "patch": "node patcher/patch.mjs",
    "push:dev": "node patcher/push-dev.mjs",
    "typecheck": "node runtime/scripts/generate-plugins.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
